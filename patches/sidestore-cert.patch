+    /// The store that installed this FlekDeck, where that was SideStore or
+    /// AltStore — the two that keep the certificate a free Apple ID signed
+    /// this FlekDeck with, which the card below asks them to hand over.
+    /// Nil for any other installer, and the card is hidden.
+    private var importStoreName: String? {
+        switch LCUtils.store() {
+        case .SideStore: return "SideStore"
+        case .AltStore: return "AltStore"
+        default: return nil
+        }
+    }
+
+    /// Whether the card that asks the store can be shown: there is one to ask,
+    /// this copy manages its own certificate, and this build can use one at
+    /// all. LiveContainer shows the same row wherever its store check passes;
+    /// the last condition is FlekDeck's own, since a build that cannot sign
+    /// has no use for what the store would hand back.
+    private var showsImportFromStore: Bool {
+        onImportFromStore != nil && importStoreName != nil
+            && managesCertificate && LCProvisioningProfile.isAppDevelopmentSigned
+    }
+
+    /// Asking the store that installed this FlekDeck for the certificate it
+    /// keeps, rather than exporting a .p12 by hand. It appears beside the
+    /// import page's card — both ways are open — and again once a certificate
+    /// is imported, as the refresh it is then: a store's certificate runs
+    /// out with the sideload's week, and the store's own refresh hands back
+    /// one valid again.
+    ///
+    /// The engine is LiveContainer's own, left over from FlekDeck's fork of
+    /// it: a build-in SideStore is read from the keychain directly, and any
+    /// SideStore or AltStore is asked through its URL scheme, handing the
+    /// certificate back through the flekdeck://certificate link this app
+    /// already opens.
+    private var importFromStoreCard: some View {
+        let storeName = importStoreName ?? ""
+        return Button {
+            onImportFromStore?()
+        } label: {
+            FlekSetupOption(
+                icon: .symbol("arrow.down.circle.fill", .green),
+                title: (sharedModel.isCertificateImported
+                        ? "lc.settings.refreshCertificateFromStore %@"
+                        : "lc.settings.importCertificateFromStore %@").localizeWithFormat(storeName),
+                subtitle: "lc.flek.certImport.store.desc %@".localizeWithFormat(storeName),
+                tray: {
+                    FlekSetupPoints(points: ["lc.flek.certImport.store.point1".loc])
+                }
+            )
+        }
+        .buttonStyle(FlekCardPressStyle())
+    }
+
     private func certificateOption<Tray: View>(
